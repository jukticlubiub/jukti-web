# Copy to .env.local and fill in. Without the Supabase values the site runs on the
# sample content in src/lib/data/, and RSVP and the helpline work only as a local preview.

# The public address of the site (used in calendar links and share metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API. The publishable key is safe in the browser;
# row-level security (supabase/migrations) decides who can read and write what.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email (the contact form and the Academic Helpline) goes through the club's Gmail.
# GMAIL_APP_PASSWORD is an app password, not the account password: turn on 2-Step
# Verification for the account, then create one at https://myaccount.google.com/apppasswords.
# Gmail allows about 500 recipients a day.
GMAIL_USER=jukti.iub@gmail.com
GMAIL_APP_PASSWORD=

# Or, instead of Gmail, Resend (resend.com).
# Sign up with the club's Gmail and create an API key. Until the club's domain is
# verified in Resend, keep the default sender, which can only deliver to that Gmail.
RESEND_API_KEY=
# Optional. Where messages go (default: the club email in src/lib/site.ts).
CONTACT_TO_EMAIL=
# Optional, once a domain is verified, e.g. "JUKTI Website <contact@your-domain>".
CONTACT_FROM_EMAIL=

# Signs the QR codes on member cards (any long random text, e.g. `openssl rand -base64 32`).
# Without it in production, cards show no QR code and door check-in by card is off.
MEMBER_CARD_SECRET=

# Site analytics (PostHog: visitors, clicks, heatmaps), production only. Leave empty to turn it off.
# The project API key (starts with phc_) is public: PostHog > Project settings. "us" or "eu" is
# the region the PostHog project was created in. Vercel Speed Insights needs no key: turn it on in
# the Vercel project (Speed Insights tab).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us
